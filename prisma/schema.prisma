generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CONSUMER
  DEALER
  INSPECTOR
  ADMIN
}

enum CylinderStatus {
  VERIFIED
  NOT_VERIFIED
  EXPIRED
  SUSPENDED
}

enum CertificationStatus {
  PENDING
  APPROVED
  EXPIRED
  SUSPENDED
  REJECTED
}

enum InspectionResult {
  PASS
  FAIL
  CONDITIONAL
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ChecklistResult {
  PASS
  FAIL
  NOT_APPLICABLE
}

enum InventoryStatus {
  IN_STOCK
  SOLD
  RESERVED
  RETURNED
  INSPECTION_REQUIRED
}

enum ComplaintCategory {
  OVERPRICING
  UNSAFE_INSTALLATION
  GAS_LEAKAGE
  DAMAGED_CYLINDER
  POOR_EQUIPMENT
  UNLICENSED_DEALER
  OTHER
}

enum ComplaintStatus {
  SUBMITTED
  UNDER_REVIEW
  ASSIGNED
  INVESTIGATION
  RESOLVED
  REJECTED
}

enum NotificationType {
  SECURITY
  CERTIFICATION
  PRICE
  COMPLAINT
  SYSTEM
  IOT
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  WARNING
  CRITICAL
}

enum DistributionStatus {
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  phone         String?
  role          UserRole       @default(CONSUMER)
  nid           String?
  address       String?
  division      String?
  district      String?
  upazila       String?
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  dealerProfile    Dealer?
  inspectorProfile Inspector?
  complaints       Complaint[]       @relation("ConsumerComplaints")
  complaintUpdates ComplaintUpdate[] @relation("UserComplaintUpdates")
  notifications    Notification[]
  reviews          Review[]
  iotDevices       IoTDevice[]

  @@index([role])
  @@index([division, district])
}

model Dealer {
  id              String         @id @default(uuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName    String
  tradeLicense    String         @unique
  division        String
  district        String
  upazila         String
  address         String
  latitude        Float?
  longitude       Float?
  phone           String
  email           String?
  isCertified     Boolean        @default(false)
  status          String         @default("ACTIVE")
  rating          Float          @default(4.5)
  totalReviews    Int            @default(0)
  currentLpgPrice Float          @default(1450.0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  cylinders            Cylinder[]
  certifications       Certification[]
  inspections          Inspection[]
  priceRecords         PriceRecord[]
  inventory            Inventory[]
  distributionReceived DistributionRecord[]
  complaintsReceived   Complaint[]
  reviews              Review[]
  iotDevices           IoTDevice[]

  @@index([division, district])
  @@index([isCertified])
}

model Inspector {
  id             String          @id @default(uuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeNumber    String          @unique
  department     String          @default("Department of Explosives")
  designation    String          @default("Field Safety Officer")
  division       String
  district       String?
  phone          String
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  inspections    Inspection[]
  certifications Certification[]

  @@index([division])
}

model Cylinder {
  id                 String         @id @default(uuid())
  serialNumber       String         @unique
  qrCode             String         @unique
  brand              String
  capacityKg         Float          @default(12.0)
  tareWeightKg       Float
  grossWeightKg      Float?
  manufactureDate    DateTime
  expiryDate         DateTime
  lastInspectionDate DateTime?
  nextInspectionDate DateTime?
  status             CylinderStatus @default(VERIFIED)
  currentDealerId    String?
  dealer             Dealer?        @relation(fields: [currentDealerId], references: [id], onDelete: SetNull)
  safetyScore        Float          @default(95.0)
  batchNumber        String?
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([status])
  @@index([serialNumber])
  @@index([currentDealerId])
}

model Certification {
  id                String              @id @default(uuid())
  certificateNumber String              @unique
  entityType        String              @default("DEALER") // DEALER or CYLINDER
  entityId          String
  dealerId          String?
  dealer            Dealer?             @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  inspectorId       String?
  inspector         Inspector?          @relation(fields: [inspectorId], references: [id], onDelete: SetNull)
  issuedAt          DateTime            @default(now())
  expiresAt         DateTime
  status            CertificationStatus @default(APPROVED)
  qrCode            String?
  notes             String?
  documentUrl       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status])
  @@index([dealerId])
}

model Inspection {
  id               String            @id @default(uuid())
  inspectionNumber String            @unique
  entityType       String            @default("DEALER") // DEALER or CYLINDER
  entityId         String
  dealerId         String?
  dealer           Dealer?           @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  inspectorId      String
  inspector        Inspector         @relation(fields: [inspectorId], references: [id])
  inspectionDate   DateTime          @default(now())
  overallResult    InspectionResult  @default(PASS)
  riskLevel        RiskLevel         @default(LOW)
  notes            String?
  latitude         Float?
  longitude        Float?
  evidencePhotoUrl String?
  signature        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  items            InspectionItem[]

  @@index([inspectorId])
  @@index([dealerId])
  @@index([overallResult])
}

model InspectionItem {
  id           String          @id @default(uuid())
  inspectionId String
  inspection   Inspection      @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  category     String          // Cylinder, Regulator, Rubber Tube, Installation, Storage
  itemTitle    String
  result       ChecklistResult @default(PASS)
  severity     RiskLevel       @default(LOW)
  notes        String?
  photoUrl     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([inspectionId])
}

model PriceRecord {
  id             String   @id @default(uuid())
  dealerId       String?
  dealer         Dealer?  @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  division       String
  district       String
  cylinderSizeKg Float    @default(12.0)
  reportedPrice  Float
  referencePrice Float
  isViolation    Boolean  @default(false)
  reportedBy     String   @default("SYSTEM")
  effectiveDate  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([division, district])
  @@index([isViolation])
}

model Inventory {
  id             String          @id @default(uuid())
  dealerId       String
  dealer         Dealer          @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  cylinderSizeKg Float           @default(12.0)
  brand          String
  currentStock   Int             @default(0)
  minStockAlert  Int             @default(10)
  status         InventoryStatus @default(IN_STOCK)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([dealerId])
}

model SupplyDepot {
  id                    String               @id @default(uuid())
  name                  String
  code                  String               @unique
  division              String
  district              String
  address               String
  capacityMetricTons    Float
  currentStockMetricTons Float
  contactPerson         String
  contactPhone          String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  distributions         DistributionRecord[]

  @@index([division])
}

model DistributionRecord {
  id             String             @id @default(uuid())
  sourceDepotId  String
  sourceDepot    SupplyDepot        @relation(fields: [sourceDepotId], references: [id])
  targetDealerId String
  targetDealer   Dealer             @relation(fields: [targetDealerId], references: [id])
  batchNumber    String
  quantity       Int
  cylinderSizeKg Float              @default(12.0)
  status         DistributionStatus @default(DELIVERED)
  dispatchDate   DateTime           @default(now())
  arrivalDate    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([sourceDepotId])
  @@index([targetDealerId])
}

model Complaint {
  id              String            @id @default(uuid())
  trackingNumber  String            @unique
  consumerId      String?
  consumer        User?             @relation("ConsumerComplaints", fields: [consumerId], references: [id], onDelete: SetNull)
  dealerId        String?
  dealer          Dealer?           @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  category        ComplaintCategory
  severity        RiskLevel         @default(MEDIUM)
  status          ComplaintStatus   @default(SUBMITTED)
  location        String
  description     String
  photoUrl        String?
  resolutionNotes String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  updates         ComplaintUpdate[]

  @@index([trackingNumber])
  @@index([status])
  @@index([dealerId])
}

model ComplaintUpdate {
  id          String          @id @default(uuid())
  complaintId String
  complaint   Complaint       @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  updatedById String?
  updatedBy   User?           @relation("UserComplaintUpdates", fields: [updatedById], references: [id], onDelete: SetNull)
  status      ComplaintStatus
  comment     String
  createdAt   DateTime        @default(now())

  @@index([complaintId])
}

model SafetyArticle {
  id             String   @id @default(uuid())
  slug           String   @unique
  title          String
  category       String   // Cylinder Safety, Regulator Safety, Leak Detection, Storage, Installation, Emergency Response
  summary        String
  content        String
  icon           String?  // Lucide icon key
  readingTimeMin Int      @default(3)
  isFeatured     Boolean  @default(false)
  orderIndex     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([isFeatured])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  linkUrl   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, isRead])
}

model IoTDevice {
  id                  String         @id @default(uuid())
  deviceSerial        String         @unique
  dealerId            String?
  dealer              Dealer?        @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  consumerId          String?
  consumer            User?          @relation(fields: [consumerId], references: [id], onDelete: SetNull)
  deviceName          String
  locationDescription String
  status              DeviceStatus   @default(ONLINE)
  batteryLevel        Int            @default(100)
  gasLevelPpm         Float          @default(15.0)
  temperatureC        Float          @default(26.0)
  lastHeartbeat       DateTime       @default(now())
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  alerts              LeakageAlert[]

  @@index([status])
}

model LeakageAlert {
  id             String    @id @default(uuid())
  deviceId       String
  device         IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  ppmLevel       Float
  severity       RiskLevel @default(HIGH)
  isResolved     Boolean   @default(false)
  resolvedAt     DateTime?
  resolvedNotes  String?
  alertTimestamp DateTime  @default(now())
  createdAt      DateTime  @default(now())

  @@index([deviceId])
  @@index([isResolved])
}

model SafetyStandard {
  id               String   @id @default(uuid())
  code             String   @unique // e.g. BDS 1530:2008
  title            String
  regulatoryBody   String   @default("BSTI / Dept of Explosives")
  category         String
  description      String
  requirementsText String
  isMandatory      Boolean  @default(true)
  effectiveYear    Int      @default(2008)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Review {
  id         String   @id @default(uuid())
  dealerId   String
  dealer     Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  consumerId String
  consumer   User     @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  rating     Int      @default(5)
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([dealerId])
}

// ── AI / ML Models ────────────────────────────────────────────────────────────

enum AIModelStatus {
  ACTIVE
  INACTIVE
  TRAINING
  FAILED
}

enum AIAlertType {
  HIGH_RISK_DEALER
  PRICE_ANOMALY
  DEMAND_SHORTAGE
  COMPLAINT_PRIORITY
}

model AIModel {
  id            String        @id @default(uuid())
  modelKey      String        @unique // e.g. "safety_risk_model"
  name          String
  algorithm     String
  version       String        @default("1.0.0")
  task          String        // binary_classification, anomaly_detection, regression, multiclass_classification
  status        AIModelStatus @default(INACTIVE)
  datasetSize   Int?
  trainingDate  DateTime?
  // Serialized JSON metrics
  metricsJson   String?
  artifactPath  String?
  notes         String?
  activatedBy   String?       // admin user id
  activatedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  trainingRuns  AITrainingRun[]
  predictions   AIPrediction[]

  @@index([modelKey])
  @@index([status])
}

model AITrainingRun {
  id            String    @id @default(uuid())
  modelId       String
  model         AIModel   @relation(fields: [modelId], references: [id], onDelete: Cascade)
  triggeredBy   String?   // admin user id
  datasetVersion String   @default("synthetic_v1")
  status        String    @default("COMPLETED") // RUNNING, COMPLETED, FAILED
  metricsJson   String?
  logOutput     String?
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([modelId])
}

model AIPrediction {
  id              String   @id @default(uuid())
  modelId         String?
  model           AIModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
  modelKey        String   // e.g. "safety_risk_model"
  entityType      String   // DEALER, PRICE_RECORD, COMPLAINT
  entityId        String   // UUID of the entity
  inputJson       String   // Serialized input features
  outputJson      String   // Serialized prediction result
  riskScore       Float?   // For safety risk predictions (0-100)
  riskLevel       String?  // LOW, MEDIUM, HIGH, CRITICAL
  isAnomaly       Boolean? // For price anomaly
  confidence      Float?   // For classification
  predictedLabel  String?  // For classification
  reviewedBy      String?  // Admin who reviewed this prediction
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime @default(now())

  @@index([modelKey])
  @@index([entityType, entityId])
  @@index([riskLevel])
}

model AIAlert {
  id          String      @id @default(uuid())
  type        AIAlertType
  title       String
  description String
  entityType  String      // DEALER, PRICE_RECORD, COMPLAINT, DISTRICT
  entityId    String
  severity    RiskLevel   @default(HIGH)
  isResolved  Boolean     @default(false)
  resolvedBy  String?
  resolvedAt  DateTime?
  resolveNote String?
  predictionId String?    // Optional link to AIPrediction
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([type])
  @@index([isResolved])
  @@index([entityType, entityId])
}
